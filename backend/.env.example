# copie para backend/.env e preencha os dados do mysql
DB_HOST=localhost
DB_NAME=bd_contatus
DB_PORT=3306
DB_USER=usuario_leitura
DB_PASSWORD=preencha_a_senha_do_banco

# opcionais: credenciais do banco para operações de enriquecimento
# se não forem definidas, utiliza DB_USER e DB_PASSWORD
# DB_USER_ADMIN=
# DB_PASSWORD_ADMIN=

DB_CONNECT_TIMEOUT=10
DB_READ_TIMEOUT=120
DB_WRITE_TIMEOUT=30

# edição local: a api sempre inicia em 127.0.0.1
API_PORT=5001
API_DEBUG=false
API_ENFORCE_HTTPS=false
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# limites técnicos, iguais para todas as operações
API_REQUEST_TIMEOUT=1800
API_QUERY_TIMEOUT=120
API_BATCH_SIZE_DB=3000
API_BATCH_MAX_ITER=500

# cache opcional
REDIS_URL=
CACHE_TTL_SECONDS=1800
LOG_LEVEL=info
